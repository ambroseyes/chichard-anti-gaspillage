# ---------------------------------------------------------------------------
# Interface web — copier en .env.local
# ---------------------------------------------------------------------------

# URL du serveur d'API. En développement, le proxy Vite s'en charge : laisser
# vide pour appeler la même origine que le front.
VITE_API_URL=http://localhost:4000

# Clé Google Maps, utilisée par l'optimisation de tournée des livreurs.
# Facultative : sans elle, les cartes basculent sur OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
