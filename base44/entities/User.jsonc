{
  "type": "object",
  "properties": {
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "is_partner": {
      "type": "boolean",
      "default": false
    },
    "is_delivery_driver": {
      "type": "boolean",
      "default": false
    },
    "store_id": {
      "type": "string"
    },
    "total_savings": {
      "type": "number",
      "default": 0
    },
    "waste_avoided_kg": {
      "type": "number",
      "default": 0
    },
    "eco_level": {
      "type": "string",
      "enum": [
        "debutant",
        "engage",
        "expert",
        "ambassadeur",
        "heros"
      ],
      "default": "debutant"
    },
    "eco_points": {
      "type": "number",
      "default": 0
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured_badge": {
      "type": "string"
    },
    "loyalty_points": {
      "type": "number",
      "default": 0
    },
    "loyalty_tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum",
        "diamond"
      ],
      "default": "bronze"
    },
    "preferences": {
      "type": "object",
      "properties": {
        "favorite_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dietary_restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notification_preferences": {
          "type": "object"
        }
      }
    },
    "trust_score": {
      "type": "number",
      "default": 50,
      "description": "Score de confiance (0-100)"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "premium_verified"
      ],
      "default": "unverified"
    },
    "reports_received": {
      "type": "number",
      "default": 0
    },
    "reports_submitted": {
      "type": "number",
      "default": 0
    },
    "successful_transactions": {
      "type": "number",
      "default": 0
    },
    "account_age_days": {
      "type": "number",
      "default": 0
    }
  },
  "name": "User",
  "required": [
    "phone",
    "city",
    "address",
    "store_id",
    "badges",
    "featured_badge",
    "preferences"
  ]
}