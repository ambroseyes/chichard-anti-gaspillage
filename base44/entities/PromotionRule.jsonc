{
  "name": "PromotionRule",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "store_id": {
      "type": "string"
    },
    "rule_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "dlc_based",
        "stock_based",
        "time_based",
        "manual"
      ],
      "description": "Type de d\u00e9clencheur"
    },
    "conditions": {
      "type": "object",
      "properties": {
        "days_before_dlc": {
          "type": "number",
          "description": "Jours avant DLC pour d\u00e9clencher"
        },
        "stock_threshold": {
          "type": "number",
          "description": "Seuil de stock pour d\u00e9clencher"
        },
        "time_of_day": {
          "type": "string",
          "description": "Heure de la journ\u00e9e"
        },
        "day_of_week": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        }
      }
    },
    "discount_action": {
      "type": "object",
      "properties": {
        "discount_type": {
          "type": "string",
          "enum": [
            "percentage",
            "fixed_amount"
          ]
        },
        "discount_value": {
          "type": "number"
        },
        "max_discount": {
          "type": "number"
        }
      }
    },
    "priority": {
      "type": "number",
      "default": 1,
      "description": "Priorit\u00e9 de la r\u00e8gle (1-10)"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "all_products",
        "specific_category",
        "specific_products"
      ],
      "default": "all_products"
    },
    "target_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_count": {
      "type": "number",
      "default": 0
    },
    "last_executed": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "store_id",
    "rule_name",
    "trigger_type"
  ]
}