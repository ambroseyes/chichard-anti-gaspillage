{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "author_eco_level": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Contenu du post"
    },
    "image_url": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "savings",
        "recipe",
        "tip",
        "challenge",
        "deal",
        "achievement",
        "question"
      ],
      "default": "savings"
    },
    "savings_amount": {
      "type": "number",
      "description": "Montant \u00e9conomis\u00e9"
    },
    "waste_avoided_kg": {
      "type": "number"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "shares_count": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "related_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "store_id": {
      "type": "string",
      "description": "Si post par un magasin"
    }
  },
  "required": [
    "author_email",
    "content",
    "post_type"
  ]
}