{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Code unique du coupon"
    },
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "PERCENT",
        "FIXED"
      ],
      "default": "FIXED"
    },
    "value": {
      "type": "number",
      "description": "Montant ou % de r\u00e9duction"
    },
    "min_cart_amount": {
      "type": "number",
      "default": 0
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "points_cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "USED",
        "EXPIRED"
      ],
      "default": "ACTIVE"
    },
    "redeemed_order_id": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "user_email",
    "type",
    "value"
  ]
}