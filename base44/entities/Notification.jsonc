{
  "name": "Notification",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "order",
        "deal",
        "expiration",
        "badge",
        "challenge",
        "social",
        "system"
      ],
      "default": "system"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "user_email",
    "title",
    "message",
    "type"
  ]
}