{
  "name": "PriceComparison",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "product_name": {
      "type": "string"
    },
    "barcode": {
      "type": "string",
      "description": "Code-barres EAN"
    },
    "brand": {
      "type": "string"
    },
    "stores_prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "store_id": {
            "type": "string"
          },
          "store_name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "discounted_price": {
            "type": "number"
          },
          "in_stock": {
            "type": "boolean"
          },
          "distance_km": {
            "type": "number"
          }
        }
      }
    },
    "best_deal": {
      "type": "object",
      "properties": {
        "store_id": {
          "type": "string"
        },
        "store_name": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "savings": {
          "type": "number"
        }
      }
    },
    "category": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "product_name"
  ]
}