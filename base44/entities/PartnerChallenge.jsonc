{
  "name": "PartnerChallenge",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID du magasin partenaire"
    },
    "store_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "purchases",
        "amount",
        "products",
        "visits"
      ],
      "default": "purchases"
    },
    "goal_value": {
      "type": "number"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "discount",
        "points",
        "free_product",
        "badge"
      ],
      "default": "points"
    },
    "reward_value": {
      "type": "number"
    },
    "reward_description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "participants_count": {
      "type": "number",
      "default": 0
    },
    "completions_count": {
      "type": "number",
      "default": 0
    },
    "total_revenue_generated": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "store_id",
    "title",
    "goal_type",
    "goal_value",
    "end_date"
  ]
}