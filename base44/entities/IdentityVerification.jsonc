{
  "name": "IdentityVerification",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "verification_type": {
      "type": "string",
      "enum": [
        "id_card",
        "passport",
        "business_license",
        "phone_verification"
      ],
      "description": "Type de v\u00e9rification"
    },
    "document_url": {
      "type": "string",
      "description": "URL du document upload\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_notes": {
      "type": "string"
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "basic",
        "advanced",
        "premium"
      ],
      "default": "basic"
    }
  },
  "required": [
    "user_email",
    "verification_type"
  ]
}