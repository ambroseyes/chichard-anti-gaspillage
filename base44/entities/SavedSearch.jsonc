{
  "name": "SavedSearch",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_email": {
      "type": "string"
    },
    "search_name": {
      "type": "string",
      "description": "Nom de la recherche sauvegard\u00e9e"
    },
    "search_query": {
      "type": "string"
    },
    "filters": {
      "type": "object",
      "description": "Filtres appliqu\u00e9s"
    },
    "entity_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types d'entit\u00e9s recherch\u00e9es"
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "search_name",
    "search_query"
  ]
}