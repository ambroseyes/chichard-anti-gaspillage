{
  "name": "UserChallenge",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_email": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "current_progress": {
      "type": "number",
      "default": 0
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_email",
    "challenge_id"
  ]
}