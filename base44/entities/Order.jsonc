{
  "name": "Order",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "customer_email": {
      "type": "string",
      "description": "Email du client"
    },
    "customer_name": {
      "type": "string",
      "description": "Nom du client"
    },
    "customer_phone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone du client"
    },
    "items": {
      "type": "array",
      "description": "Articles command\u00e9s",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "store_name": {
            "type": "string"
          }
        }
      }
    },
    "total_amount": {
      "type": "number",
      "description": "Montant total"
    },
    "total_savings": {
      "type": "number",
      "description": "\u00c9conomies r\u00e9alis\u00e9es"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "ready",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "orange_money",
        "mtn_money",
        "cash",
        "card"
      ],
      "description": "Mode de paiement"
    },
    "delivery_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery"
      ],
      "default": "pickup"
    },
    "delivery_address": {
      "type": "string",
      "description": "Adresse de livraison"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "qr_scanned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure du scan QR"
    },
    "qr_scan_attempts": {
      "type": "number",
      "default": 0,
      "description": "Nombre de tentatives de scan"
    },
    "delivery_proof": {
      "type": "object",
      "description": "Preuve de livraison"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_by": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "items",
    "total_amount"
  ]
}