{
  "name": "DashboardPreference",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_email": {
      "type": "string"
    },
    "dashboard_type": {
      "type": "string",
      "enum": [
        "partner",
        "driver"
      ],
      "description": "Type de tableau de bord"
    },
    "visible_widgets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des widgets actifs"
    },
    "widget_order": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "alerts_config": {
      "type": "object",
      "properties": {
        "low_stock_threshold": {
          "type": "number",
          "default": 5
        },
        "urgent_delivery_minutes": {
          "type": "number",
          "default": 30
        },
        "daily_sales_target": {
          "type": "number"
        },
        "enable_push_notifications": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "chart_preferences": {
      "type": "object",
      "properties": {
        "default_period": {
          "type": "string",
          "enum": [
            "7d",
            "30d",
            "90d"
          ],
          "default": "7d"
        },
        "chart_type": {
          "type": "string",
          "enum": [
            "line",
            "bar",
            "area"
          ],
          "default": "line"
        }
      }
    }
  },
  "required": [
    "user_email",
    "dashboard_type"
  ]
}