{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "challenge_type": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "special"
      ],
      "default": "weekly"
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "savings",
        "orders",
        "waste_avoided",
        "products_saved",
        "referrals"
      ],
      "description": "Type d'objectif"
    },
    "goal_value": {
      "type": "number",
      "description": "Valeur cible"
    },
    "reward_badge": {
      "type": "string",
      "description": "Badge \u00e0 gagner"
    },
    "reward_points": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "participants_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "goal_type",
    "goal_value",
    "end_date"
  ]
}