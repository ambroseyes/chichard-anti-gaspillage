{
  "name": "ChatRoom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "category": {
      "type": "string",
      "enum": [
        "recettes",
        "astuces",
        "defis",
        "bons_plans",
        "general"
      ],
      "default": "general"
    },
    "icon": {
      "type": "string"
    },
    "members_count": {
      "type": "number",
      "default": 0
    },
    "last_message": {
      "type": "string"
    },
    "last_message_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ]
}