{
  "name": "CartItem",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "product_id": {
      "type": "string",
      "description": "ID du produit"
    },
    "product_name": {
      "type": "string"
    },
    "product_image": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number"
    },
    "original_price": {
      "type": "number"
    },
    "store_name": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_email",
    "product_id",
    "quantity",
    "unit_price"
  ]
}