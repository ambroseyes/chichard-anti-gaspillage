{
  "name": "DigitalReceipt",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "receipt_number": {
      "type": "string"
    },
    "receipt_image_url": {
      "type": "string",
      "description": "URL de l'image du ticket"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "payment_method": {
      "type": "string"
    },
    "cashback_earned": {
      "type": "number",
      "default": 0
    },
    "points_earned": {
      "type": "number",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "cashback_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid"
      ],
      "default": "pending"
    }
  },
  "required": [
    "user_email",
    "store_name",
    "total_amount",
    "purchase_date"
  ]
}