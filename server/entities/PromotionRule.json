{
  "name": "PromotionRule",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "rule_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "dlc_based",
        "stock_based",
        "time_based",
        "manual"
      ],
      "description": "Type de déclencheur"
    },
    "conditions": {
      "type": "object",
      "properties": {
        "days_before_dlc": {
          "type": "number",
          "description": "Jours avant DLC pour déclencher"
        },
        "stock_threshold": {
          "type": "number",
          "description": "Seuil de stock pour déclencher"
        },
        "time_of_day": {
          "type": "string",
          "description": "Heure de la journée"
        },
        "day_of_week": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        }
      }
    },
    "discount_action": {
      "type": "object",
      "properties": {
        "discount_type": {
          "type": "string",
          "enum": [
            "percentage",
            "fixed_amount"
          ]
        },
        "discount_value": {
          "type": "number"
        },
        "max_discount": {
          "type": "number"
        }
      }
    },
    "priority": {
      "type": "number",
      "default": 1,
      "description": "Priorité de la règle (1-10)"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "all_products",
        "specific_category",
        "specific_products"
      ],
      "default": "all_products"
    },
    "target_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_count": {
      "type": "number",
      "default": 0
    },
    "last_executed": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "store_id",
    "rule_name",
    "trigger_type"
  ]
}