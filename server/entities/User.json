{
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Identifiant de connexion",
      "unique": true
    },
    "full_name": {
      "type": "string"
    },
    "password_hash": {
      "type": "string",
      "description": "Argon2id — jamais exposé par l'API"
    },
    "avatar_url": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "backoffice_role": {
      "type": "string",
      "enum": [
        "none",
        "operator",
        "admin",
        "super_admin"
      ],
      "default": "none"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_login_at": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "is_partner": {
      "type": "boolean",
      "default": false
    },
    "is_delivery_driver": {
      "type": "boolean",
      "default": false
    },
    "store_id": {
      "type": "string"
    },
    "total_savings": {
      "type": "number",
      "default": 0
    },
    "waste_avoided_kg": {
      "type": "number",
      "default": 0
    },
    "eco_level": {
      "type": "string",
      "enum": [
        "debutant",
        "engage",
        "expert",
        "ambassadeur",
        "heros"
      ],
      "default": "debutant"
    },
    "eco_points": {
      "type": "number",
      "default": 0
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured_badge": {
      "type": "string"
    },
    "loyalty_points": {
      "type": "number",
      "default": 0
    },
    "loyalty_tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum",
        "diamond"
      ],
      "default": "bronze"
    },
    "preferences": {
      "type": "object",
      "properties": {
        "favorite_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dietary_restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notification_preferences": {
          "type": "object"
        }
      }
    },
    "trust_score": {
      "type": "number",
      "default": 50,
      "description": "Score de confiance (0-100)"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "premium_verified"
      ],
      "default": "unverified"
    },
    "reports_received": {
      "type": "number",
      "default": 0
    },
    "reports_submitted": {
      "type": "number",
      "default": 0
    },
    "successful_transactions": {
      "type": "number",
      "default": 0
    },
    "account_age_days": {
      "type": "number",
      "default": 0
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "referral_code": {
      "type": "string"
    },
    "referrals_count": {
      "type": "number",
      "default": 0
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "is_public_profile": {
      "type": "boolean",
      "default": true
    },
    "allow_messages": {
      "type": "boolean",
      "default": true
    },
    "dietary_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allergens_to_avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "favorite_stores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community_badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "name": "User",
  "required": [
    "email"
  ]
}