{
  "name": "LoyaltyReward",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "points_required": {
      "type": "number"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "discount",
        "free_delivery",
        "exclusive_product",
        "badge",
        "experience"
      ]
    },
    "reward_value": {
      "type": "number",
      "description": "Valeur en FCFA ou pourcentage"
    },
    "image_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tier_required": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze"
    },
    "stock": {
      "type": "number"
    }
  },
  "required": [
    "title",
    "points_required",
    "reward_type"
  ]
}