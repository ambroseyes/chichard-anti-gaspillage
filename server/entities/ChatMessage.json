{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "link",
        "product"
      ],
      "default": "text"
    },
    "attachment_url": {
      "type": "string"
    },
    "reactions": {
      "type": "object"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "room_id",
    "sender_email",
    "content"
  ]
}