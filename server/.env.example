# ---------------------------------------------------------------------------
# Serveur Chichard — copier en .env et compléter
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://chichard:chichard@localhost:5432/chichard

# --- Authentification ------------------------------------------------------
# Générer avec :  openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Secret distinct pour les jetons de retrait (QR). openssl rand -hex 32
PICKUP_TOKEN_SECRET=

# --- Tarification ----------------------------------------------------------
DELIVERY_FEE_XAF=1000
FREE_DELIVERY_THRESHOLD_XAF=25000
# kg de CO2 évités par kg de produit sauvé (ADEME : ~2.5 pour un panier moyen)
CO2_KG_PER_KG_SAVED=2.5

# --- Paiement mobile -------------------------------------------------------
# manual | orange_money | mtn_momo
PAYMENT_PROVIDER=manual
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_ID=
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# Secret partagé pour authentifier les webhooks de l'opérateur
PAYMENT_WEBHOOK_SECRET=

# --- E-mail (SMTP) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Chichard <no-reply@chichard.cm>"

# --- SMS (optionnel) -------------------------------------------------------
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=CHICHARD

# --- IA (recettes, coach, prévisions) --------------------------------------
# none | anthropic
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Stockage des fichiers -------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
PUBLIC_BASE_URL=http://localhost:4000
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tâches planifiées -----------------------------------------------------
ENABLE_SCHEDULER=true
TZ=Africa/Douala
